<?xml version="1.0" encoding="utf-8"?>
<mx:WindowedApplication xmlns:fx="http://ns.adobe.com/mxml/2009"
    xmlns:mx="library://ns.adobe.com/flex/mx" width="500" height="320"
    title="MX desktop MXML recovery" layout="vertical" backgroundColor="0xEAF4FF">
    <fx:Script><![CDATA[
        [Bindable]
        private var message:String = "An MX desktop application";
        private function updateMessage():void {
            message = "The MX desktop button was clicked";
        }
    ]]></fx:Script>
    <mx:Label id="mxDesktopLabel" text="{message}"/>
    <mx:Button id="mxDesktopButton" label="Update MX desktop message" click="updateMessage()"/>
</mx:WindowedApplication>
