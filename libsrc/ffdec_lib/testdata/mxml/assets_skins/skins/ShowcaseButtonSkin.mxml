<?xml version="1.0" encoding="utf-8"?>
<s:Skin xmlns:fx="http://ns.adobe.com/mxml/2009"
    xmlns:s="library://ns.adobe.com/flex/spark" minWidth="180" minHeight="32">
    <fx:Metadata>[HostComponent("spark.components.Button")]</fx:Metadata>
    <s:states>
        <s:State name="up"/><s:State name="over"/>
        <s:State name="down"/><s:State name="disabled"/>
    </s:states>
    <s:Rect left="0" right="0" top="0" bottom="0" radiusX="6">
        <s:fill><s:SolidColor color="0xDCEEFF" color.over="0xBBDDEE" color.down="0x99BBDD"/></s:fill>
    </s:Rect>
    <s:Label id="labelDisplay" horizontalCenter="0" verticalCenter="0"/>
</s:Skin>
