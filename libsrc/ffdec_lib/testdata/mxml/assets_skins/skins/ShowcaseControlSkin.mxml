<?xml version="1.0" encoding="utf-8"?>
<s:Skin xmlns:fx="http://ns.adobe.com/mxml/2009"
    xmlns:s="library://ns.adobe.com/flex/spark">
    <fx:Metadata>[HostComponent("components.ShowcaseControl")]</fx:Metadata>
    <s:states><s:State name="normal"/><s:State name="highlighted"/></s:states>
    <s:Rect left="0" right="0" top="0" bottom="0" radiusX="8">
        <s:fill><s:SolidColor color="0xDCEEFF" color.highlighted="0xFFE0A0"/></s:fill>
    </s:Rect>
    <s:Label id="labelDisplay" text="{hostComponent.caption}" left="12" verticalCenter="0"/>
</s:Skin>
